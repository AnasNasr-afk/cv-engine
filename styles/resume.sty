\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/resume}[2026/08/27 Resume layout and entry primitives]

% ---------------------------------------------------------------
% Package loading.
% Order is significant: fullpage must precede geometry, and
% glyphtounicode sits between the multicol lengths and geometry.
% Do not reorder without re-checking the rendered margins.
% ---------------------------------------------------------------
\RequirePackage{latexsym}
\RequirePackage[empty]{fullpage}
\RequirePackage{titlesec}
\RequirePackage{marvosym}
\RequirePackage[usenames,dvipsnames]{color}
\RequirePackage{verbatim}
\RequirePackage{enumitem}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage[english]{babel}
\RequirePackage{tabularx}
\RequirePackage{multicol}
\setlength{\multicolsep}{-3.0pt}
\setlength{\columnsep}{-1pt}
\input{glyphtounicode}
% Sides: 0.5in each, the reference CV's text width (523pt) centred.
% Top and bottom stay tight at 1.1cm.
\RequirePackage[left=0.5in, right=0.5in, top=0.45cm, bottom=0.45cm]{geometry}

% ---------------------------------------------------------------
% Page style: no header, no footer, no rules.
% ---------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
% Fill the page: leftover space is spread across the stretchable gaps
% below (sections, entries), so every one-page CV ends at the bottom
% margin instead of leaving a white band. Gaps never shrink below the
% reference CV's spacing; they only grow.
\flushbottom
% LaTeX ends a document with \vfil, which would soak up all leftover
% space and leave the gaps above untouched. On a one-page CV, cancel it
% so the gaps share the space. Multi-page CVs keep normal behaviour.
\AtEndDocument{\ifnum\value{page}=1 \par\vspace{0pt plus -1fil}\fi}
\raggedright
\setlength{\tabcolsep}{0in}

% ---------------------------------------------------------------
% Section headings: small caps, followed by a full-width rule.
% ---------------------------------------------------------------
\titleformat{\section}{
  \vspace{-3pt}\scshape\raggedright\small
}{}{0em}{}[\color{black}\titlerule\vspace{-3pt}]
% Space before / after a section heading, tuned to the reference CV.
\titlespacing*{\section}{0pt}{9.5pt plus 8pt}{7.5pt plus 2pt}

% Emit a ToUnicode map so the PDF stays copy-pasteable and ATS-readable.
\pdfgentounicode=1

% ---------------------------------------------------------------
% Entry primitives.
% ---------------------------------------------------------------

% \resumeItem{text} -- a single bullet.
\newcommand{\resumeItem}[1]{
  \item\small{{#1\vspace{1pt}}}
}

% \resumeSubheading{org}{location}{role}{dates} -- two-line job/school entry.
\newcommand{\resumeSubheading}[4]{
  \vspace{-1pt plus 3pt}\item\small
    \begin{tabular*}{\linewidth}[t]{l@{\extracolsep{\fill}}r}
      \small\textbf{#1} & {\small #2} \\
      \textit{\small#3} & {\small #4} \\
    \end{tabular*}\vspace{-5pt}
}

% \resumeEducation{school}{location}{degree}{dates}{detail rows}
% No bullets: the degree upright, then plain detail lines (thesis,
% grade) underneath. #5 holds zero or more \resumeEducationDetail rows.
\newcommand{\resumeEducationDetail}[1]{\multicolumn{2}{l}{\small #1} \\}
\newcommand{\resumeEducation}[5]{
  \vspace{-1pt plus 3pt}\item\small
    \begin{tabular*}{\linewidth}[t]{l@{\extracolsep{\fill}}r}
      \small\textbf{#1} & {\small #2} \\
      \small #3 & {\small #4} \\
      #5
    \end{tabular*}\vspace{-5pt}
}

% \resumeProjectHeading{title + stack}{links or dates} -- one-line entry.
% The 1.001 is deliberate: the 0.58pt overflow forces the line break the
% following \vspace relies on. At exactly 1.0 the headings collapse onto
% their bullets. \hfuzz keeps that overflow out of the log.
\newcommand{\resumeProjectHeading}[2]{
  \vspace{-1pt plus 3pt}\item\hfuzz=1pt
    \begin{tabular*}{1.001\linewidth}{l@{\extracolsep{\fill}}r}
      \small\textbf{#1} & \small #2\\
    \end{tabular*}\vspace{-6pt}
}

% \resumeDescription{text} -- plain paragraph under a project or
% leadership heading, aligned with the heading text (no bullet), as in
% the reference CV.
\newcommand{\resumeDescription}[1]{\small #1\par}

\renewcommand\labelitemi{\small$\bullet$}
\renewcommand\labelitemii{\small$\bullet$}

% List wrappers. \resumeSubHeadingListStart holds entries;
% \resumeItemListStart holds the bullets inside one entry.
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.2in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}\vspace{0pt}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.35in]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-8pt}}

% ---------------------------------------------------------------
% Tabular (German Lebenslauf) primitives.
%
% A Lebenslauf runs dates down a fixed left column with the entry
% body flowing beside it. Two side-by-side minipages give that far
% more reliably than a tabularx whose cells must hold itemize --
% list spacing inside table cells is fragile, and the entries here
% carry bullets.
%
% Used only by roles that set layout = "tabular"; the bullet-style
% \resume* commands above are untouched.
% ---------------------------------------------------------------
\newlength{\cvdatewidth}
\setlength{\cvdatewidth}{4.0cm}

% \cventry{dates}{body} -- one row of the Lebenslauf.
\newcommand{\cventry}[2]{%
  \par\vspace{5pt}\noindent
  \begin{minipage}[t]{\cvdatewidth}\small\raggedright #1\end{minipage}%
  \begin{minipage}[t]{\dimexpr\textwidth-\cvdatewidth\relax}\raggedright #2\end{minipage}%
  \par
}

% \cvfact{label}{value} -- a personal-details line. Same geometry as
% \cventry so the left column stays flush the whole way down the page.
\newcommand{\cvfact}[2]{%
  \par\vspace{1.5pt}\noindent
  \begin{minipage}[t]{\cvdatewidth}\small\raggedright #1\end{minipage}%
  \begin{minipage}[t]{\dimexpr\textwidth-\cvdatewidth\relax}\small\raggedright #2\end{minipage}%
  \par
}

% Tight bullet list for use inside a \cventry body.
\newcommand{\cvbullets}{\begin{itemize}[leftmargin=0.16in, topsep=1pt, itemsep=0pt, parsep=0pt]}
\newcommand{\cvbulletsend}{\end{itemize}}

% A field the author has not supplied yet. Rendered loudly on purpose:
% a Lebenslauf is an official document and a silently missing field is
% worse than an obvious one.
\newcommand{\cvmissing}[1]{\textcolor{Red}{\textbf{[#1 -- to be completed]}}}

\endinput
